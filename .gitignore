# Git ignore file for Job Application Agent

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Database
*.sqlite3
*.db
*.sqlite

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Storage & User Data (Sessions contain authenticated browser state)
storage/resumes/*
!storage/resumes/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep
storage/browser_sessions/*
!storage/browser_sessions/.gitkeep
storage/screenshots/*
!storage/screenshots/.gitkeep

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Node / Frontend
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db
