# Application Configuration
APP_NAME="Job Application Agent"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-32-character-key

# Database Configuration (SQLite default for local dev, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./storage/job_agent.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_agent

# Storage Paths (relative to workspace root or absolute)
STORAGE_DIR=./storage
RESUMES_DIR=./storage/resumes
SESSIONS_DIR=./storage/sessions
SCREENSHOTS_DIR=./storage/screenshots

# AI / LLM Provider Configuration
LLM_PROVIDER=openai # openai, anthropic, groq, ollama, mock
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Embedding Provider Configuration
EMBEDDING_PROVIDER=openai # openai, huggingface, mock
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Browser Automation Configuration
BROWSER_HEADLESS=True
BROWSER_SLOW_MO_MS=50
BROWSER_TIMEOUT_MS=30000

# Rate Limiting & Scheduling
MAX_APPLICATIONS_PER_DAY=20
DISCOVERY_INTERVAL_MINUTES=360
ENABLE_AUTO_DRAFTING=True

# Human-In-The-Loop Enforcement
REQUIRE_EXPLICIT_APPROVAL=True
